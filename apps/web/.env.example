# 演示模式（默认）：使用 src/data/mock-ops-data.ts
# VITE_OPS_API_MODE=mock

# 本地 FastAPI 联调（勿提交真实凭证；**仅 `pnpm dev` / Vite DEV，不会进入生产 bundle**）：
# VITE_OPS_API_MODE=http
# VITE_OPS_API_BASE_URL=http://127.0.0.1:8000
# Production/staging HTTPS builds also require comma-separated API origins:
# VITE_OPS_API_ALLOWED_ORIGINS=https://api.example.com
# 下列 admin 头仅用于本机 `.env.local` 联调；生产应使用 HttpOnly 会话 Cookie、`credentials: include` 或 WebView handoff 后的 setOpsRuntimeAuth
# VITE_OPS_ADMIN_AUTHORIZATION=Bearer <local-dev-only>
# VITE_OPS_ADMIN_MFA=<mfa-proof-for-local-only>
# VITE_OPS_ADMIN_ROLE=viewer
